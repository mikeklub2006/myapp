{
  "openapi": "3.0.3",
  "info": {
    "title": "ЛР24 - Users API (группа 401)",
    "version": "1.0.0",
    "description": "REST API для работы с пользователями на Koa.js и MongoDB. Клубович Михаил, группа 401, вариант 8."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "group_name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Петр Петров"
          },
          "email": {
            "type": "string",
            "example": "petr@example.com"
          },
          "group_name": {
            "type": "string",
            "example": "401"
          },
          "age": {
            "type": "integer",
            "example": 20
          },
          "course": {
            "type": "integer",
            "example": 2
          }
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserInput"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "pages": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Список пользователей с пагинацией, фильтрами и сортировкой",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "example": "-age"
            }
          },
          {
            "in": "query",
            "name": "group_name",
            "schema": {
              "type": "string",
              "example": "401"
            }
          },
          {
            "in": "query",
            "name": "course",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "age_min",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "age_max",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации query-параметров"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Создание пользователя",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создан"
          },
          "400": {
            "description": "Ошибка валидации"
          },
          "401": {
            "description": "Нет токена"
          },
          "409": {
            "description": "Email уже существует"
          }
        }
      }
    },
    "/api/users/search": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Полнотекстовый поиск по имени и email",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Найденные пользователи с оценкой релевантности"
          }
        }
      }
    },
    "/api/users/stats": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Статистика (агрегация MongoDB)",
        "responses": {
          "200": {
            "description": "Общее количество",
            "средний возраст": null,
            "распределение по группам и курсам": null
          }
        }
      }
    },
    "/api/users/export": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Экспорт пользователей в CSV или JSON",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "json"
              ],
              "default": "csv"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Файл с пользователями"
          }
        }
      }
    },
    "/api/users/import": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Импорт пользователей (JSON-массив или файл .csv/.json)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserInput"
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Количество добавленных и пропущенных записей"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Пользователь по id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Пользователь"
          },
          "404": {
            "description": "Не найден"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Обновление (владелец, admin или moderator)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Обновлен"
          },
          "403": {
            "description": "Недостаточно прав"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Мягкое удаление (владелец или admin), ставится deleted_at",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Удален"
          },
          "404": {
            "description": "Не найден"
          }
        }
      }
    },
    "/api/users/{id}/avatar": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Загрузка аватара (png, jpeg, gif, webp до 2 МБ)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Аватар сохранен"
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получить аватар",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Изображение"
          },
          "404": {
            "description": "Нет аватара"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Все пользователи, включая удаленные (только admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "withDeleted",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список"
          },
          "403": {
            "description": "Нужна роль admin"
          }
        }
      }
    },
    "/api/admin/users/{id}/restore": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Восстановить удаленного пользователя",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Восстановлен"
          }
        }
      }
    },
    "/api/admin/users/{id}/role": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "summary": "Сменить роль пользователя",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "moderator",
                      "admin"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Роль изменена"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Проверка, что приложение живо",
        "responses": {
          "200": {
            "description": "{ status, uptime, db }"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Готовность принимать запросы (есть соединение с БД)",
        "responses": {
          "200": {
            "description": "Готово"
          },
          "503": {
            "description": "Не готово"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Метрики в формате Prometheus",
        "responses": {
          "200": {
            "description": "text/plain"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Регистрация",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Иван"
                  },
                  "email": {
                    "type": "string",
                    "example": "ivan@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "secret123"
                  },
                  "group_name": {
                    "type": "string",
                    "example": "401"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь и пара токенов"
          },
          "409": {
            "description": "Email уже существует"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Вход, возвращает access (15 мин) и refresh (7 дней) токены",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "admin123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токены"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Обновление пары токенов по refresh-токену",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новые токены"
          },
          "401": {
            "description": "Недействительный refresh-токен"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Выход (refresh-токен отзывается)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Выход выполнен"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Текущий пользователь",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Профиль"
          }
        }
      }
    }
  },
  "tags": []
}
