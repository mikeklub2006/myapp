NODE_ENV=development
PORT=3000
# без MONGO_URI в режиме development запускается MongoDB в памяти
# MONGO_URI=mongodb://localhost:27017
DB_NAME=bbmo_401
JWT_SECRET=change-me-access-secret-401
JWT_REFRESH_SECRET=change-me-refresh-secret-401
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
LOG_LEVEL=info
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SSL_KEY_PATH=/run/secrets/key.pem
# SSL_CERT_PATH=/run/secrets/cert.pem
